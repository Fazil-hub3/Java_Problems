import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of customers: ");
        int m = sc.nextInt();
        System.out.print("Enter number of banks: ");
        int n = sc.nextInt();
        int[][] accounts = new int[m][n];

        for (int i = 0; i < m; i++) {
            System.out.println("Enter wealth for customer " + (i + 1) + ":");
            for (int j = 0; j < n; j++) accounts[i][j] = sc.nextInt();
        }

        int richest = 0;
        for (int i = 0; i < m; i++) {
            int wealth = 0;
            for (int j = 0; j < n; j++) wealth += accounts[i][j];
            if (wealth > richest) richest = wealth;
        }
        System.out.println("Richest customer wealth: " + richest);
    }
}