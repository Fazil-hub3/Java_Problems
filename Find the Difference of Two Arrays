import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter size of first array: ");
        int m = sc.nextInt();
        int[] a = new int[m];
        System.out.println("Enter first array:");
        for (int i = 0; i < m; i++) a[i] = sc.nextInt();

        System.out.print("Enter size of second array: ");
        int n = sc.nextInt();
        int[] b = new int[n];
        System.out.println("Enter second array:");
        for (int i = 0; i < n; i++) b[i] = sc.nextInt();

        System.out.println("Unique elements in first array but not second:");
        for (int i = 0; i < m; i++) {
            boolean found = false, repeated = false;
            for (int j = 0; j < n; j++) if (a[i] == b[j]) found = true;
            for (int j = 0; j < i; j++) if (a[i] == a[j]) repeated = true;
            if (!found && !repeated) System.out.print(a[i] + " ");
        }

        System.out.println("\nUnique elements in second array but not first:");
        for (int i = 0; i < n; i++) {
            boolean found = false, repeated = false;
            for (int j = 0; j < m; j++) if (b[i] == a[j]) found = true;
            for (int j = 0; j < i; j++) if (b[i] == b[j]) repeated = true;
            if (!found && !repeated) System.out.print(b[i] + " ");
        }
    }
}