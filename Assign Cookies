import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of children: ");
        int m = sc.nextInt();
        int[] greed = new int[m];
        System.out.println("Enter greed factors:");
        for (int i = 0; i < m; i++) greed[i] = sc.nextInt();

        System.out.print("Enter number of cookies: ");
        int n = sc.nextInt();
        int[] cookies = new int[n];
        System.out.println("Enter cookie sizes:");
        for (int i = 0; i < n; i++) cookies[i] = sc.nextInt();

        for (int i = 0; i < m - 1; i++)
            for (int j = 0; j < m - i - 1; j++)
                if (greed[j] > greed[j + 1]) {
                    int t = greed[j]; greed[j] = greed[j + 1]; greed[j + 1] = t;
                }
        for (int i = 0; i < n - 1; i++)
            for (int j = 0; j < n - i - 1; j++)
                if (cookies[j] > cookies[j + 1]) {
                    int t = cookies[j]; cookies[j] = cookies[j + 1]; cookies[j + 1] = t;
                }

        int child = 0, cookie = 0;
        while (child < m && cookie < n) {
            if (cookies[cookie] >= greed[child]) child++;
            cookie++;
        }
        System.out.println("Content children: " + child);
    }
}